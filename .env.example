# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001

# Supabase/PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/funil_metrics
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_SSL_CA_FILE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Jobs
QUEUE_DRIVER=memory
REDIS_URL=
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=25
WORKER_MAX_ATTEMPTS=5

# Cloudflare R2 (configuração futura; não preencher no cliente)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Um único bucket privado usa os prefixos imutáveis `quarantine/` e
# `assets-private/`. Configuração parcial impede a inicialização do worker.

# ClamAV privado
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
CLAMAV_MAX_BYTES=2147483648

# Integrações futuras
LASTLINK_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
INTEGRATION_SECRET_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=

# Redirecionador A/B na borda
EDGE_SHARED_SECRET=
